#!/usr/bin/env bash
# Committed pre-push gates. Enable once per clone:
#   git config core.hooksPath .githooks
# 1. Leak gate — blocks a push carrying a candidate client/PII identifier.
# 2. Skill-description cap gate — blocks a push whose SKILL.md description would be
#    truncated mid-sentence in Claude Code's skill listing (losing trigger phrases).
# See CONTRIBUTING.md.
set -e
ROOT="$(git rev-parse --show-toplevel)"
bash "$ROOT/scripts/leak_scan.sh" "$ROOT"
exec python3 "$ROOT/scripts/check_skill_descriptions.py" "$ROOT" --no-color --triggers
