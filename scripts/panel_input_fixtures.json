    {"name": "reserve_complete", "path": ["scope", "reserve"], "value": "COMPLETE", "expect": "scope.reserve must be NOT_RUN"},
    {"name": "publish_complete", "path": ["scope", "publish"], "value": "COMPLETE", "expect": "scope.publish must be NOT_RUN"},
    {"name": "final_fact_review_complete", "path": ["scope", "final_fact_review"], "value": "COMPLETE", "expect": "scope.final_fact_review must be NOT_RUN"},
    {"name": "postpublication_panel_complete", "path": ["scope", "postpublication_panel"], "value": "COMPLETE", "expect": "scope.postpublication_panel must be NOT_RUN"},
    {"name": "accept_complete", "path": ["scope", "accept"], "value": "COMPLETE", "expect": "scope.accept must be NOT_RUN"},
