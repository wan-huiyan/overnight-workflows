    {"name": "undeclared_repository_field", "path": ["repositories", "package_source"], "field": "unexpected", "value": true, "expect": "repositories.package_source has undeclared fields"},
    {"name": "undeclared_installed_field", "path": ["installed"], "field": "unexpected", "value": true, "expect": "installed has undeclared fields"},
    {"name": "undeclared_prepare_field", "path": ["prepare"], "field": "unexpected", "value": true, "expect": "prepare has undeclared fields"},
    {"name": "undeclared_scope_field", "path": ["scope"], "field": "unexpected", "value": true, "expect": "scope has undeclared fields"}
