  "drift_cases": [
    {"name": "target_ref_drift", "mutation": "target_ref", "expect": "target_ref no longer resolves"},
    {"name": "raw_sha_target_ref", "mutation": "raw_sha_target_ref", "expect": "fully qualified symbolic ref"},
    {"name": "dot_target_ref", "mutation": "dot_target_ref", "expect": "fully qualified symbolic ref"},
    {"name": "merge_base_not_target", "mutation": "merge_base_not_target", "expect": "merge_base_sha must equal target_sha"},
    {"name": "diff_argv_drift", "mutation": "diff_argv", "expect": "diff_argv must equal"},
    {"name": "diff_repository_argv_drift", "mutation": "diff_repository_argv", "expect": "diff_argv must equal"},
    {"name": "diff_flag_order_drift", "mutation": "diff_flag_order", "expect": "diff_argv must equal"},
    {"name": "diff_digest_drift", "mutation": "diff_digest", "expect": "saved diff digest differs"},
    {"name": "inventory_digest_drift", "mutation": "inventory_digest", "expect": "inventory digest differs"},
    {"name": "inventory_count_drift", "mutation": "inventory_count", "expect": "inventory file_count differs"},
    {"name": "inventory_bytes_drift", "mutation": "inventory_bytes", "expect": "inventory total_bytes differs"},
    {"name": "generation_drift", "mutation": "generation", "expect": "generation_id must be"},
    {"name": "source_commit_drift", "mutation": "source_commit", "expect": "source_tree does not match"},
    {"name": "source_tree_drift", "mutation": "source_tree", "expect": "source_tree does not match"},
    {"name": "snapshot_byte_drift", "mutation": "snapshot_byte", "expect": "inventory digest differs"},
    {"name": "installed_repository_join_drift", "mutation": "installed_repository_join", "expect": "must match exactly one reviewed repository"},
    {"name": "repository_role_key_drift", "mutation": "repository_role_key_drift", "expect": "repository_roles values must be exactly the repository keys"},
    {"name": "repository_role_duplicate", "mutation": "repository_role_duplicate", "expect": "repository_roles must map roles one-to-one"},
    {"name": "installed_source_role_drift", "mutation": "installed_source_role_drift", "expect": "installed_source role must identify the reviewed repository"},
    {"name": "hardcoded_repository_names_without_role_map", "mutation": "hardcoded_repository_names_without_role_map", "repository_keys": ["global", "doodlerun"], "expect": "repository_roles values must be exactly the repository keys"},
    {"name": "repository_identity_too_long", "mutation": "repository_identity_too_long", "expect": "repository key is invalid"}
  ],
  "boundary_cases": [
    {
      "name": "postpublication_boundary",
      "path": ["review_boundary"],
      "value": "postpublication-installed-and-finalized",
      "expect": "review_boundary must be one of"
    }
  ],
  "prepare_cases": [
