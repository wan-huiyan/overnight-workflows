    {"name": "receipt_symlink", "target": "receipt", "kind": "symlink", "expect": "regular non-symlink single-link file"},
    {"name": "receipt_hardlink", "target": "receipt", "kind": "hardlink", "expect": "regular non-symlink single-link file"},
    {"name": "receipt_size_race", "target": "receipt", "kind": "size_race", "expect": "changed identity or size while being read"},
    {"name": "state_symlink", "target": "state", "kind": "symlink", "expect": "regular non-symlink single-link file"},
